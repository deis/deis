#!/bin/bash
set -eo pipefail

repository=$1
app=${1%.git}
sha=$2
username=$3
fingerprint=$4

buildkey='{{ .deis_controller_builderKey }}'
controllerhost='{{ .deis_controller_host }}'
controllerport='{{ .deis_controller_port }}'

if [ "$buildkey" == '<no value>' ]; then
	echo "Deis build key not set. Please report this to your system administrator."
	exit 1
fi

if [ "$controllerhost" == '<no value>' ]; then
	echo "Deis controller host not set. Please report this to your system administrator."
	exit 1
fi

if [ "$controllerport" == '<no value>' ]; then
	echo "Deis controller port not set. Please report this to your system administrator."
	exit 1
fi

curl \
  -X 'POST' --fail \
  -H 'Content-Type: application/json' \
  -H "X-Deis-Builder-Auth: $buildkey" \
  -d "{\"receive_user\": \"$username\", \"receive_repo\": \"$app\", \"sha\": \"$sha\", \"fingerprint\": \"$fingerprint\", \"ssh_connection\": \"$SSH_CONNECTION\", \"ssh_original_command\": \"$SSH_ORIGINAL_COMMAND\"}" \
  --silent http://$controllerhost:$controllerport/api/hooks/push >/dev/null
