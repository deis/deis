[Unit]
Description=deis-cache

[Service]
EnvironmentFile=/etc/environment
TimeoutStartSec=20m
ExecStartPre=/bin/sh -c "docker inspect deis-cache >/dev/null 2>&1 && docker rm -f deis-cache || true"
ExecStartPre=/bin/sh -c "IMAGE=`/run/deis/bin/get_image /deis/cache` && docker create --name deis-cache -p 6379:6379 -e EXTERNAL_PORT=6379 -e HOST=$COREOS_PRIVATE_IPV4 $IMAGE"
ExecStart=/usr/bin/docker start -a deis-cache
ExecStop=/usr/bin/docker stop -t 2 deis-cache ; /usr/bin/docker rm -f deis-cache
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
