[Unit]
Description=deis-store-daemon
Requires=deis-store-data@%i.service
After=deis-store-data@%i.service

[Service]
EnvironmentFile=/etc/environment
TimeoutStartSec=20m
ExecStartPre=/bin/sh -c "IMAGE=`/run/deis/bin/get_image /deis/store-daemon`; docker history $IMAGE >/dev/null 2>&1 || docker pull $IMAGE"
ExecStartPre=/bin/sh -c "docker inspect deis-store-daemon >/dev/null 2>&1 && docker rm -f deis-store-daemon || true"
ExecStart=/bin/sh -c "IMAGE=`/run/deis/bin/get_image /deis/store-daemon` && docker run --name deis-store-daemon --rm -e HOST=$COREOS_PRIVATE_IPV4 -p 6800 --net host --volumes-from deis-store-data $IMAGE"

[Install]
WantedBy=multi-user.target

[X-Fleet]
MachineOf=deis-store-data@%i.service
