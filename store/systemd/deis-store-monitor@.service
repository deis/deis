[Unit]
Description=deis-store-monitor
Requires=deis-store-data@%i.service
After=deis-store-data@%i.service

[Service]
EnvironmentFile=/etc/environment
TimeoutStartSec=20m
ExecStartPre=/bin/sh -c "IMAGE=`/run/deis/bin/get_image /deis/store-monitor`; docker history $IMAGE >/dev/null 2>&1 || docker pull $IMAGE"
ExecStartPre=/bin/sh -c "docker inspect deis-store-monitor >/dev/null 2>&1 && docker rm -f deis-store-monitor || true"
ExecStartPre=/bin/sh -c "etcdctl set /deis/store/hosts/$COREOS_PRIVATE_IPV4 `hostname` >/dev/null"
ExecStart=/bin/sh -c "IMAGE=`/run/deis/bin/get_image /deis/store-monitor` && docker run --name deis-store-monitor --rm -e HOST=$COREOS_PRIVATE_IPV4 -p 6789 --net host --volumes-from deis-store-data $IMAGE"

[Install]
WantedBy=multi-user.target

[X-Fleet]
MachineOf=deis-store-data@%i.service
