#!/usr/bin/env bash

# create or truncate the file
> /etc/ssl/deis_certs

{{ range $cert := .deis_certs }}
echo {{ $cert.Key }} >> /etc/ssl/deis_certs
{{ end }}

CERT_PATH=/etc/ssl/deis/certs
KEY_PATH=/etc/ssl/deis/keys

# clean up all certs
rm -rf $CERT_PATH
rm -rf $KEY_PATH

# ...then re-create the paths
mkdir -p $CERT_PATH
mkdir -p $KEY_PATH

while read etcd_path; do
  ETCD_CERT_SLUG="${etcd_path}/cert"
  ETCD_KEY_SLUG="${etcd_path}/key"

  # cert template
  etcdctl -C $HOST:4001 get $ETCD_CERT_SLUG > "$CERT_PATH/$(basename $etcd_path).cert"
  etcdctl -C $HOST:4001 get $ETCD_KEY_SLUG  > "$KEY_PATH/$(basename $etcd_path).key"
done < /etc/ssl/deis_certs
