#!/usr/bin/env bash

CERT_PATH=/etc/ssl/deis/certs
KEY_PATH=/etc/ssl/deis/keys

# clean up all certs
rm -rf $CERT_PATH
rm -rf $KEY_PATH

# ...then re-create the paths
mkdir -p $CERT_PATH
mkdir -p $KEY_PATH

ETCD_CERTS=$(etcdctl -C 172.17.8.102:4001 ls /deis/certs)

for CURRENT_CERT in $ETCD_CERTS; do
  echo "Generating ssl certificate for $(basename $CURRENT_CERT)..."
  ETCD_CERT_SLUG="$CURRENT_CERT/cert"
  ETCD_KEY_SLUG="$CURRENT_CERT/key"

  # cert template
  etcdctl -C $HOST:4001 get $ETCD_CERT_SLUG > "$CERT_PATH/$(basename $CURRENT_CERT).cert"
  etcdctl -C $HOST:4001 get $ETCD_KEY_SLUG  > "$KEY_PATH/$(basename $CURRENT_CERT).key"
done
